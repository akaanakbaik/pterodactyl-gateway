{
  "name": "@akaanakbaik/pterodactyl-gateway",
  "version": "1.4.2",
  "description": "Full-featured TypeScript SDK untuk Pterodactyl Panel. Fokus pada kemudahan integrasi untuk developer membangun dashboard, bot, dan sistem otomasi panel yang kompleks.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ptero-gateway": "dist/cli-entry.js",
    "ptg": "dist/cli-entry.js",
    "ptero-wizard": "dist/wizard-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "BLUEPRINT.md",
    "add-promt.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && npm run chmod:bin",
    "chmod:bin": "node -e \"const fs=require('fs'); for (const f of ['dist/cli.js','dist/cli-entry.js','dist/wizard-cli.js']) if (fs.existsSync(f)) fs.chmodSync(f, 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "test:cli": "npm run build && node dist/cli-entry.js help && node dist/cli-entry.js version --json && node dist/cli-entry.js self-check --json && node dist/cli-entry.js release-check --json",
    "test:pack": "npm run build && npm pack --dry-run",
    "test:release": "node scripts/release-guard.js",
    "security:audit": "npm audit --audit-level=high",
    "ci": "npm run verify && npm run security:audit",
    "cli": "node dist/cli-entry.js",
    "wizard": "node dist/wizard-cli.js",
    "verify": "npm run typecheck && npm test && npm run test:cli && npm run test:pack && npm run test:release",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "pterodactyl",
    "pterodactyl-panel",
    "pterodactyl-api",
    "pterodactyl-sdk",
    "pterodactyl-cli",
    "pterodactyl-client",
    "pterodactyl-application-api",
    "pterodactyl-client-api",
    "pterodactyl-gateway",
    "server-control",
    "server-management",
    "game-panel",
    "hosting-panel",
    "panel-automation",
    "bot-hosting",
    "whatsapp-bot",
    "telegram-bot",
    "discord-bot",
    "baileys",
    "grammy",
    "discordjs",
    "dashboard",
    "typescript",
    "nodejs",
    "sdk",
    "cli"
  ],
  "author": "akaanakbaik",
  "license": "MIT",
  "homepage": "https://github.com/akaanakbaik/pterodactyl-gateway#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akaanakbaik/pterodactyl-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/akaanakbaik/pterodactyl-gateway/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "nodemailer": "^9.0.3",
    "ws": "^8.21.0"
  }
}
